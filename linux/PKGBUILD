# Maintainer: aeone.games OÜ <team@aeone.games>
#
# TEMPLATE. The desktop release step fills the @…@ placeholders and publishes the result
# to aeone-games/desktop (linux/PKGBUILD) — edit this file in the playtest repo
# (tools/electron/linux/), never the published copy.
pkgname=aeone-games-bin
pkgver=0.1.11
pkgrel=1
pkgdesc="aeone.games desktop app"
arch=('x86_64')
url="https://play.aeone.games"
license=('LicenseRef-aeone-games')
depends=('gtk3' 'nss' 'alsa-lib' 'vulkan-icd-loader')
optdepends=('vulkan-driver: WebGPU rendering (the games require it)'
            'gamemode: Feral GameMode while a game runs')
provides=('aeone-games')
conflicts=('aeone-games')
# Prebuilt Electron: stripping or splitting debug info from Chromium's binaries breaks them.
options=('!strip' '!debug')
source=("https://github.com/aeone-games/desktop/releases/download/v${pkgver}/aeone-games-${pkgver}-linux-x64.tar.gz"
        'aeone.games.desktop'
        'aeone.games.png'
        'LICENSE')
sha256sums=('b81cfb72d8b7fb381686179d717b233fb1db810fad7957af910ab13e8fbac146'
            'b8c6c027a79e63297b688f15f72c5e5329d2138baafa3311923938ba594e6241'
            'fbfede3d2537aec37818ac1cd88251f0a189742005a09b9706c5521392d4b53d'
            '14c093774159b5af502462f7884193be60cc8a5dc338e1e148ae8d1cb89b54f2')

package() {
  install -dm755 "$pkgdir/opt/aeone-games"
  cp -a "aeone-games-${pkgver}-linux-x64/." "$pkgdir/opt/aeone-games/"
  # chrome-sandbox keeps its packaged mode: Arch kernels allow unprivileged user
  # namespaces, so Chromium sandboxes without a setuid-root helper.
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/aeone-games/aeone-games "$pkgdir/usr/bin/aeone-games"
  # The entry's basename is the Wayland app_id main.mjs reports for packaged runs.
  install -Dm644 aeone.games.desktop "$pkgdir/usr/share/applications/aeone.games.desktop"
  install -Dm644 aeone.games.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/aeone.games.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
